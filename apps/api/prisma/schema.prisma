// Kiki system-of-record. Models mirror @kiki/domain types (packages/domain/src/domain/types.ts)
// 1:1, so the same schema holds the seeded demo world AND Kiki's real imported data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TraitKind {
  origin
  education
  interest
  work
  event
}

enum Provenance {
  matched
  inferred
  self_declared
}

enum ContributionKind {
  hosted
  vouched
  referred
  reviewed
  attended
  stayed
}

/// A member of the Kiki trust network.
model Member {
  id          String   @id
  name        String
  country     String
  avatarColor String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  traits        Trait[]
  listings      Listing[]
  contributions Contribution[]
  generated     GeneratedContent?
  user          User?

  vouchesGiven    Vouch[] @relation("vouchFrom")
  vouchesReceived Vouch[] @relation("vouchTo")

  reviewsAsHost   Review[] @relation("reviewHost")
  reviewsAuthored Review[] @relation("reviewAuthor")

  guestReviewsAbout    GuestReview[] @relation("guestSubject")
  guestReviewsAuthored GuestReview[] @relation("guestAuthor")

  stayRequestsAsGuest StayRequest[] @relation("reqGuest")
  stayRequestsAsHost  StayRequest[] @relation("reqHost")
  trips               Trip[]        @relation("tripAuthor")
  tripOffers          TripOffer[]   @relation("offerHost")

  threadsA     Thread[]  @relation("threadA")
  threadsB     Thread[]  @relation("threadB")
  messagesSent Message[] @relation("msgSender")

  @@map("members")
}

/// A profile fact we can find overlaps against.
model Trait {
  id         String     @id @default(cuid())
  memberId   String
  kind       TraitKind
  key        String
  label      String
  provenance Provenance @default(self_declared)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([key])
  @@map("traits")
}

/// A directed trust edge: `from` personally vouches for `to`.
model Vouch {
  id               String  @id @default(cuid())
  fromId           String
  toId             String
  note             String?
  noteSubject      String? // free-text display name the note is about (not a member ref)
  consentToDisplay Boolean @default(false)
  stays            Int?
  sharedEvents     Int?

  from Member @relation("vouchFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Member @relation("vouchTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@map("vouches")
}

/// A listing a member offers while away.
model Listing {
  id            String   @id
  hostId        String
  title         String
  area          String
  pricePerNight Int // GBP per night, the unit Kiki’s own app prices in
  kind          String // "Room" | "Whole place" (kept as text to match the domain literal)
  lat           Float
  lng           Float
  photoColor    String
  photoUrl      String?
  tags          String[]

  host         Member        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  reviews      Review[]
  stayRequests StayRequest[]

  @@index([hostId])
  @@map("listings")
}

/// A guest-book entry: what a guest wrote about a stay.
model Review {
  id        String @id
  hostId    String
  authorId  String
  listingId String
  text      String
  day       Int

  host    Member  @relation("reviewHost", fields: [hostId], references: [id], onDelete: Cascade)
  author  Member  @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@map("reviews")
}

/// A review written about a guest by a host who hosted them (cold-state track record).
model GuestReview {
  id        String @id
  subjectId String
  authorId  String
  text      String
  day       Int

  subject Member @relation("guestSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  Member @relation("guestAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@map("guest_reviews")
}

/// One thing a member did for the community; drives their tier/standing.
model Contribution {
  id       String           @id @default(cuid())
  memberId String
  kind     ContributionKind
  day      Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("contributions")
}

/// AI-generated content baked per member (intro / bio / guest-book summary).
model GeneratedContent {
  memberId  String  @id
  intro     String?
  bio       String?
  guestBook Json?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("generated_content")
}

// ─── Auth (Phase 2): passwordless, invite-gated accounts ─────────────────────

/// A real user account. Passwordless (email OTP), invite-gated. Maps to a Member profile.
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  memberId    String?   @unique
  invitedById String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  member         Member?        @relation(fields: [memberId], references: [id])
  invitedBy      User?          @relation("InviteTree", fields: [invitedById], references: [id])
  invitees       User[]         @relation("InviteTree")
  invitesCreated Invite[]       @relation("InviteCreator")
  inviteClaimed  Invite?        @relation("InviteClaimer")
  refreshTokens  RefreshToken[]

  @@map("users")
}

/// An invite code — the trust gate. Everyone joins through a friend.
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String? // optional targeted invite
  createdById String
  claimedById String?   @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  claimedBy User? @relation("InviteClaimer", fields: [claimedById], references: [id])

  @@index([code])
  @@map("invites")
}

/// A one-time passwordless code sent to an email (stored hashed, attempt-limited).
model OtpToken {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String // "login" | "signup"
  inviteCode String? // carried through signup so verify can claim it
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("otp_tokens")
}

/// A refresh token (stored hashed) with rotation + family-based reuse detection.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Writes (Phase 3): persisted, user-scoped, idempotent ────────────────────

enum RequestState {
  pending
  accepted
  declined
}

enum TripState {
  open
  upcoming
  past
}

/// A guest's request to stay at a listing. Host accepts/declines; state is persisted.
model StayRequest {
  id        String       @id @default(cuid())
  listingId String
  guestId   String
  hostId    String
  fromDay   Int
  toDay     Int
  nights    Int
  message   String?
  state     RequestState @default(pending)
  createdAt DateTime     @default(now())
  decidedAt DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest   Member  @relation("reqGuest", fields: [guestId], references: [id], onDelete: Cascade)
  host    Member  @relation("reqHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, state])
  @@index([guestId])
  @@map("stay_requests")
}

/// A stretch away that a member posts; Kikiers answer with partial-coverage offers on the rent.
model Trip {
  id             String    @id @default(cuid())
  authorId       String
  title          String
  kind           String
  fromDay        Int
  toDay          Int
  nights         Int
  budgetPerNight Int
  state          TripState @default(open)
  createdAt      DateTime  @default(now())

  author Member      @relation("tripAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  offers TripOffer[]

  @@index([authorId])
  @@map("trips")
}

/// A Kikier's partial offer against a stretch away (covers some of the weeks, not necessarily all).
model TripOffer {
  id               String   @id @default(cuid())
  tripId           String
  hostId           String
  nights           Int
  total            Int
  requestedFromDay Int
  requestedToDay   Int
  note             String?
  createdAt        DateTime @default(now())

  trip Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  host Member @relation("offerHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_offers")
}

/// Stripe-style idempotency: a write with the same (user, key) returns the stored result.
model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  key       String
  result    Json
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("idempotency_keys")
}

// ─── Messaging (Phase 4): persisted + real-time ──────────────────────────────

/// A 1:1 direct-message thread. The pair (aId,bId) is stored normalised (aId < bId) so a thread
/// is unique regardless of who opened it. `originNote` records how it opened (e.g. a vouch route).
model Thread {
  id         String   @id @default(cuid())
  aId        String
  bId        String
  originNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  a        Member    @relation("threadA", fields: [aId], references: [id], onDelete: Cascade)
  b        Member    @relation("threadB", fields: [bId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
  @@map("threads")
}

/// A single message in a thread. `readAt` is set when the recipient reads it.
model Message {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender Member @relation("msgSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("messages")
}

// ─── AI (Phase 6): server-side intro generation, resilient ───────────────────

/// Cache of generated intros keyed by the hash of the exact (voice + facts) prompt, so a demo
/// survives quota exhaustion: live model → cache → baked → deterministic compose.
model AiCache {
  promptHash String   @id
  text       String
  model      String?
  createdAt  DateTime @default(now())

  @@map("ai_cache")
}
