{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["react", "vitest/globals"]
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
