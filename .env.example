# ─────────────────────────────────────────────────────────────────────────────
# Kiki monorepo — single source of env. Copy this file to `.env` and fill in.
#   cp .env.example .env
# Everything (API, seed, apps) reads from the root .env. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Phase 1) --------------------------------------------------------
# Neon Postgres connection string. Create a project at https://neon.tech, then
# paste the pooled connection string here (starts with postgresql://...).
DATABASE_URL=

# Direct (non-pooled) URL — used by Prisma migrations. From Neon: the "direct" URL.
DIRECT_URL=

# --- AI (Phase 6, already have this) -------------------------------------------
# Reused from kiki-connect-demo/.pipeline.env. Server-side only, never in a client bundle.
GEMINI_API_KEY=

# --- Auth (Phase 2) ------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Email provider for passwordless OTP (e.g. Resend). Fill when Phase 2 lands.
EMAIL_API_KEY=
EMAIL_FROM=

# --- Cache / rate-limit (Phase 1+) ---------------------------------------------
# Optional Redis (Upstash) URL; falls back to in-memory in dev if empty.
REDIS_URL=

# --- Media (Phase 5) -----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Runtime -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
